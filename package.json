{
  "name": "atom-crm-web",
  "version": "0.1.0",
  "private": true,
  "description": "The responsive React web application for atom-crm.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "bundle:check": "node scripts/check-production-bundle.mjs",
    "api:snapshot": "node scripts/fetch-openapi.mjs",
    "api:generate": "openapi-typescript openapi/atom-crm.json -o src/api/generated/schema.d.ts",
    "api:coverage": "node scripts/generate-api-coverage.mjs",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/api/generated",
    "e2e:seed": "node scripts/seed-e2e.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.20",
    "antd": "^6.5.0",
    "dayjs": "^1.11.19",
    "isbot": "^5",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.71.2",
    "react-router": "^8.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^8.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.2.6",
    "vitest": "^4.0.16"
  },
  "license": "MIT"
}
