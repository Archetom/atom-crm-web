{
  "name": "atom-crm-web",
  "version": "0.1.0",
  "private": true,
  "description": "The responsive React web application for atom-crm.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/generate-nginx-config.mjs",
    "typecheck": "react-router typegen && node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "bundle:check": "node scripts/check-production-bundle.mjs",
    "api:snapshot": "node scripts/fetch-openapi.mjs",
    "api:generate": "openapi-typescript openapi/atom-crm.json -o src/api/generated/schema.d.ts",
    "api:coverage": "node scripts/generate-api-coverage.mjs",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/api/generated",
    "e2e:seed": "node scripts/seed-e2e.mjs",
    "test:e2e:production": "playwright test -c playwright.production.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@hookform/resolvers": "6.0.2",
    "@tanstack/react-query": "5.105.0",
    "antd": "6.6.8",
    "dayjs": "1.11.23",
    "isbot": "5.2.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
